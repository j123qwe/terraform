namespace = "rke2-lab"
mac_seed  = "rke2-lab"
image_id  = "default/ubuntu-24.04-cloudimg-amd64"

vm_username         = "ubuntu"
vm_ssh_public_key   = "ssh-ed25519 AAAAExampleReplaceMe user@example"
ssh_private_key_path = "~/.ssh/id_ed25519"
# Set true to verify SSH host keys instead of accepting any key.
verify_ssh_host_keys = false

nic1_network_name = "default/vlan0"
nic2_network_name = "default/vlan111"
nic1_gateway      = "192.168.0.1"
nic1_dns_servers  = ["192.168.0.10", "1.1.1.1"]
master_nic1_cidr  = "192.168.0.101/24"
worker_nic1_cidrs = ["192.168.0.111/24", "192.168.0.112/24", "192.168.0.113/24"]
master_nic2_cidr  = "10.111.0.101/24"
worker_nic2_cidrs = ["10.111.0.111/24", "10.111.0.112/24", "10.111.0.113/24"]

# Reserve these addresses on the primary LAN; keep them out of DHCP and node IPs.
load_balancer_ip_range = {
  start = "192.168.0.200"
  stop  = "192.168.0.220"
}

# Optional interface regex override; otherwise the primary NIC is detected.
# l2_announcement_interface = "^enp1s0$"

# Applications are deployed automatically after the cluster.
domain     = "nip.io"
acme_email = "user@example.com" # Reserved for a future ACME issuer; self-signed does not use it.
traefik_load_balancer_ip = "192.168.0.205" # Optional reserved IP inside or outside the pool.
# grafana_host = "grafana.example.com" # Defaults to grafana.<Traefik IP>.<domain>.
